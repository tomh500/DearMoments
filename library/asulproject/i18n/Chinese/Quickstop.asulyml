text "# KICore 急停配置文件 - 推荐稳定版" ""
text "quick_stop:" ""
text "  # 核心逻辑参数" ""
text "  logic:" ""
text "    # 1. 基础脉冲 (ms)" "推荐 15-18"
int "min_pulse" "1,100,12" "/quick_stop/logic"
text "    # 2. 最大脉冲 (ms)" "通常 35-45 足够"
int "max_pulse" "1,200,70" "/quick_stop/logic"
text "    # 3. 硬件截断上限 (ms)" "必须大于或等于 max_pulse"
int "cap_pulse" "1,300,90" "/quick_stop/logic"
text "    # 4. 线性起始时间 (ms)" "小身位拉扯建议 300"
int "move_start_at" "1,2000,240" "/quick_stop/logic"
text "    # 5. 线性达峰时间 (ms)" "觉得跑久了急停软就缩短"
int "move_cap_at" "1,5000,1380" "/quick_stop/logic"
text "  # 拦截设置" ""
text "  interception:" ""
text "    # 静默键列表: 160:Shift, 162:Ctrl, 164:Alt" ""
line "silent_keys" "静默键列表 (例如 [160, 162],以标准YML数组形式填写)" "%1" "[160, 162]" "/quick_stop/interception"
