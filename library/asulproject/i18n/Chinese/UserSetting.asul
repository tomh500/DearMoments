text "//------------------------------------------------------------------------"
text "//--------------------------------滚轮功能相关-----------------------------"
text "//------------------------------------------------------------------------"
text "//"
text "//你可以分离控制你的上下滚轮绑定，轻松关闭滚轮跳！"
text ""
text "//DearMoments_Mwheelup_Jump        上滚轮跳 [上滚轮跳 *%jump->MoMot_MW_A%*]"
text "//DearMoments_Mwheelup_slot        上滚轮切换物品栏 [%NULL%]"
func "上滚轮 功能" "选择上滚轮使用时的功能" "DearMoments_Mwheelup_Jump" 3
    "DearMoments_Mwheelup_Jump" "上滚轮跳 "
    "DearMoments_Mwheelup_slot" "上滚轮切换物品栏"
    "DearMoments_Mwheelup_custom" "自定义 "

text ""
text "//DearMoments_Mwheeldown_Jump     下滚轮跳 [下滚轮跳  *%jump->MoMot_MW_A%*]"
text "//DearMoments_Mwheeldown_slot      下滚轮切换物品栏 [%NULL%]"
func "下滚轮 功能" "选择下滚轮使用时的功能" "DearMoments_Mwheeldown_Jump" 3
    "DearMoments_Mwheeldown_Jump" "下滚轮跳"
    "DearMoments_Mwheeldown_slot" "下滚轮切换物品栏"
    "DearMoments_Mwheeldown_custom" "自定义"

text "//------------------------------------------------------------------------"
text "//------------------------------------------------------------------------"
text "//--------------------------------声音功能相关-----------------------------"
text "//------------------------------------------------------------------------"
text "//这玩意虽然不要钱，但请酌情使用，否则会很喧闹"
text ""
text "//DearMoments_RP_KnifeSnd_0            不替换切刀声音"
text "//DearMoments_RP_KnifeSnd_1            替换切刀声音为短剑 [切刀音效替换 *短剑*]"
text "//DearMoments_RP_KnifeSnd_2            替换切刀声音为折刀 [切刀音效替换 *折刀*]"
text "//DearMoments_RP_KnifeSnd_3            替换切刀声音为双匕 [切刀音效替换 *双匕*]"
text "//DearMoments_RP_KnifeSnd_4            替换切刀声音为锯齿 [切刀音效替换 *锯齿*]"
text "//DearMoments_RP_KnifeSnd_5            替换切刀声音为折叠 [切刀音效替换 *折叠刀*]"
text "//DearMoments_RP_KnifeSnd_6            替换切刀声音为博伊 [切刀音效替换 *博伊刀*]"
text "//DearMoments_RP_KnifeSnd_7            替换切刀声音为蝴蝶 [切刀音效替换 *蝴蝶刀*]"
func "切刀声音替换" "这玩意虽然不要钱，但请酌情使用，否则会很喧闹" "DearMoments_RP_KnifeSnd_1" 8
    "DearMoments_RP_KnifeSnd_0" "不替换切刀声音"
    "DearMoments_RP_KnifeSnd_1" "替换切刀声音为短剑"
    "DearMoments_RP_KnifeSnd_2" "替换切刀声音为折刀"
    "DearMoments_RP_KnifeSnd_3" "替换切刀声音为双匕"
    "DearMoments_RP_KnifeSnd_4" "替换切刀声音为锯齿"
    "DearMoments_RP_KnifeSnd_5" "替换切刀声音为折叠"
    "DearMoments_RP_KnifeSnd_6" "替换切刀声音为博伊"
    "DearMoments_RP_KnifeSnd_7" "替换切刀声音为蝴蝶"

text ""
text "//轻松使用声音提示你开关模块"
text ""
text "//DearMoments_SoundTips_Enable         开启声音提示 [输出到音频流]"
text "//DearMoments_SoundTips_Disable        关闭声音提示 [%NULL%]"
func "声音提示" "开启或关闭声音提示" "DearMoments_SoundTips_Enable" 2
    "DearMoments_SoundTips_Enable" "开启声音提示"
    "DearMoments_SoundTips_Disable" "关闭声音提示"
